CREATE VIRTUAL TABLE PurchaseFts USING fts5(
    purchase_id UNINDEXED,
    trip_id UNINDEXED,
    name,
    place
);

INSERT INTO PurchaseFts(purchase_id, trip_id, name, place)
SELECT id, trip_id, name, IFNULL(place, '') FROM PurchaseEntity;

CREATE VIRTUAL TABLE DiaryFts USING fts5(
    entry_id UNINDEXED,
    trip_id UNINDEXED,
    text
);

INSERT INTO DiaryFts(entry_id, trip_id, text)
SELECT id, trip_id, text FROM DiaryEntity;
