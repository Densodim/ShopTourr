package com.shoptourr.api.config;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.http.converter.json.JacksonJsonHttpMessageConverter;

import tools.jackson.databind.DeserializationFeature;
import tools.jackson.databind.ObjectMapper;
import tools.jackson.databind.SerializationFeature;
import tools.jackson.databind.json.JsonMapper;
import tools.jackson.databind.module.SimpleModule;
import tools.jackson.databind.ser.std.ToStringSerializer;

import java.math.BigDecimal;

/**
 * EXAMPLE for Spring Boot 4 (Jackson 3).
 * Copy into backend and adjust imports if your Boot version
 * still bridges via spring.jackson / ObjectMapper builder APIs.
 *
 * Contract rule: BigDecimal ↔ JSON string ("96.50"), never float.
 */
@Configuration
public class JacksonMoneyConfig {

    @Bean
    ObjectMapper objectMapper() {
        SimpleModule moneyModule = new SimpleModule();
        moneyModule.addSerializer(BigDecimal.class, ToStringSerializer.instance);

        return JsonMapper.builder()
                .addModule(moneyModule)
                .disable(SerializationFeature.WRITE_DATES_AS_TIMESTAMPS)
                .disable(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES)
                .build();
    }
}
